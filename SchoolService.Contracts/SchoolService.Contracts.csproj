<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>SchoolService.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Authors>Dat Nguyen</Authors>
    <Company>HighSchoolManagement</Company>
    <Description>HTTP contracts for SchoolService: request/response DTOs and the Refit client interface (ISchoolsApi).</Description>
    <PackageTags>schoolservice;contracts;dto;refit</PackageTags>

    <!-- Ship XML docs so consumers see the comments in IntelliSense; CS1591 = missing comment, not needed on every DTO property -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Schools\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Refit" Version="16.1.0" />
  </ItemGroup>

</Project>
